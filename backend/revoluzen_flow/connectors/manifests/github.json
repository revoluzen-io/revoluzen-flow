{
  "id": "github",
  "name": "GitHub",
  "description": "GitHub REST API v3",
  "category": "saas",
  "base_url": "https://api.github.com",
  "auth": {
    "type": "bearer",
    "token_param": "personal_access_token",
    "header_name": "Authorization",
    "header_template": "Bearer {token}"
  },
  "headers": {"Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"},
  "source_watch": {
    "version_probe": {
      "url": "https://api.github.com/versions",
      "from": "json",
      "pointer": [],
      "notes": "Unauthenticated; returns the full supported-version list, newest first. An empty pointer passes the whole list through so the check can tell 'a newer version exists, ours still supported' (warn) from 'ours is no longer listed' (critical). Do not narrow this to [0] — comparing only the newest reports a healthy connector as broken."
    },
    "spec_url": "https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.json"
  },
  "params": [
    {"name": "personal_access_token", "label": "Personal Access Token", "required": true, "secret": true},
    {"name": "owner", "label": "Owner/org", "required": true},
    {"name": "repo", "label": "Repository", "required": false}
  ],
  "streams": [
    {
      "name": "repos",
      "label": "Repositories",
      "path": "/users/{owner}/repos",
      "method": "GET",
      "query": {"per_page": 100},
      "pagination": {"type": "link_header", "max_pages": 100}
    },
    {
      "name": "issues",
      "label": "Issues",
      "path": "/repos/{owner}/{repo}/issues",
      "method": "GET",
      "query": {"state": "all", "per_page": 100},
      "pagination": {"type": "link_header", "max_pages": 100}
    },
    {
      "name": "pulls",
      "label": "Pull Requests",
      "path": "/repos/{owner}/{repo}/pulls",
      "method": "GET",
      "query": {"state": "all", "per_page": 100},
      "pagination": {"type": "link_header", "max_pages": 100}
    }
  ]
}
