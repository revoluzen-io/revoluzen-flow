{
  "about": "Rules the Data Quality step can and cannot run. Two tests read this file and must agree on every line: frontend/src/__tests__/dataQualityRuleCases.test.ts (the editor's check) and backend/tests/test_dq_unusable_rules.py (the node, which stops the run on a rule it cannot use instead of letting every row through). usable=false means the node raises; it does not mean the rule fails rows.",
  "cases": [
    { "name": "not_null needs no value", "rule": { "column": "id", "op": "not_null" }, "usable": true },
    { "name": "no op reads as not_null", "rule": { "column": "id" }, "usable": true },
    { "name": "is_null needs no value", "rule": { "column": "id", "op": "is_null" }, "usable": true },
    { "name": "a stray empty value on not_null is ignored", "rule": { "column": "id", "op": "not_null", "value": "" }, "usable": true },
    { "name": "eq with 0", "rule": { "column": "n", "op": "eq", "value": 0 }, "usable": true },
    { "name": "eq with false", "rule": { "column": "flag", "op": "eq", "value": false }, "usable": true },
    { "name": "eq with an empty string is a value", "rule": { "column": "s", "op": "eq", "value": "" }, "usable": true },
    { "name": "ne with text", "rule": { "column": "s", "op": "ne", "value": "x" }, "usable": true },
    { "name": "gt with a number", "rule": { "column": "n", "op": "gt", "value": 10 }, "usable": true },
    { "name": "lte with a numeric string", "rule": { "column": "n", "op": "lte", "value": "10" }, "usable": true },
    { "name": "gte with a decimal", "rule": { "column": "n", "op": "gte", "value": 1.5 }, "usable": true },
    { "name": "lt with a negative number", "rule": { "column": "n", "op": "lt", "value": -3 }, "usable": true },
    { "name": "in with a list", "rule": { "column": "s", "op": "in", "value": ["a", "b"] }, "usable": true },
    { "name": "in with one bare value", "rule": { "column": "s", "op": "in", "value": "a" }, "usable": true },
    { "name": "in with a bare number", "rule": { "column": "n", "op": "in", "value": 5 }, "usable": true },
    { "name": "in with a list holding an empty string", "rule": { "column": "s", "op": "in", "value": [""] }, "usable": true },
    { "name": "not_in with numbers", "rule": { "column": "n", "op": "not_in", "value": [1, 2] }, "usable": true },
    { "name": "between with numbers", "rule": { "column": "n", "op": "between", "value": [10, 100] }, "usable": true },
    { "name": "between with numeric strings", "rule": { "column": "n", "op": "between", "value": ["10", "100"] }, "usable": true },
    { "name": "between with text", "rule": { "column": "s", "op": "between", "value": ["a", "m"] }, "usable": true },
    { "name": "between with low above high runs and passes no row", "rule": { "column": "n", "op": "between", "value": [100, 10] }, "usable": true },
    { "name": "regex with a pattern", "rule": { "column": "s", "op": "regex", "value": "^a" }, "usable": true },
    { "name": "regex with a single space", "rule": { "column": "s", "op": "regex", "value": " " }, "usable": true },
    { "name": "min_length with a number", "rule": { "column": "s", "op": "min_length", "value": 3 }, "usable": true },
    { "name": "min_length with a numeric string", "rule": { "column": "s", "op": "min_length", "value": "5" }, "usable": true },
    { "name": "max_length with 0", "rule": { "column": "s", "op": "max_length", "value": 0 }, "usable": true },
    { "name": "min_length with 5.0", "rule": { "column": "s", "op": "min_length", "value": 5.0 }, "usable": true },
    { "name": "the old template shape check + min + max reads as a plain not_null (the editor warns about the keys)", "rule": { "column": "amount", "check": "between", "min": 0, "max": 100 }, "usable": true },
    { "name": "a key the step does not read is ignored", "rule": { "column": "id", "op": "not_null", "severity": "high" }, "usable": true },

    { "name": "a rule that is null", "rule": null, "usable": false },
    { "name": "a rule that is a string", "rule": "id", "usable": false },
    { "name": "a rule that is a number", "rule": 5, "usable": false },
    { "name": "a rule that is a list", "rule": ["id", "not_null"], "usable": false },

    { "name": "no column key", "rule": { "op": "not_null" }, "usable": false },
    { "name": "an empty column", "rule": { "column": "", "op": "not_null" }, "usable": false },
    { "name": "a blank column", "rule": { "column": "   ", "op": "eq", "value": 1 }, "usable": false },
    { "name": "a null column", "rule": { "column": null, "op": "not_null" }, "usable": false },
    { "name": "a column that is a list", "rule": { "column": ["id"], "op": "not_null" }, "usable": false },
    { "name": "the old template shape type + columns (not_null)", "rule": { "type": "not_null", "columns": ["order_id"] }, "usable": false },
    { "name": "the old template shape type + columns (unique)", "rule": { "type": "unique", "columns": ["id"] }, "usable": false },

    { "name": "an op the step does not have (unique)", "rule": { "column": "v", "op": "unique" }, "usable": false },
    { "name": "an op the step does not have (contains)", "rule": { "column": "v", "op": "contains", "value": "a" }, "usable": false },
    { "name": "an op in capitals", "rule": { "column": "v", "op": "BETWEEN", "value": [1, 2] }, "usable": false },
    { "name": "an op that is a number", "rule": { "column": "v", "op": 5 }, "usable": false },

    { "name": "eq with no value", "rule": { "column": "v", "op": "eq" }, "usable": false },
    { "name": "ne with a null value", "rule": { "column": "v", "op": "ne", "value": null }, "usable": false },
    { "name": "gt with a list", "rule": { "column": "v", "op": "gt", "value": [1, 2] }, "usable": false },
    { "name": "lte with an object", "rule": { "column": "v", "op": "lte", "value": { "a": 1 } }, "usable": false },
    { "name": "lt with no value", "rule": { "column": "v", "op": "lt" }, "usable": false },
    { "name": "gte with a null value", "rule": { "column": "v", "op": "gte", "value": null }, "usable": false },

    { "name": "in with no value", "rule": { "column": "v", "op": "in" }, "usable": false },
    { "name": "in with a null value", "rule": { "column": "v", "op": "in", "value": null }, "usable": false },
    { "name": "in with an empty string", "rule": { "column": "v", "op": "in", "value": "" }, "usable": false },
    { "name": "in with a blank string", "rule": { "column": "v", "op": "in", "value": "   " }, "usable": false },
    { "name": "in with an empty list", "rule": { "column": "v", "op": "in", "value": [] }, "usable": false },
    { "name": "in with a list of one null", "rule": { "column": "v", "op": "in", "value": [null] }, "usable": false },
    { "name": "not_in with a null among the values", "rule": { "column": "v", "op": "not_in", "value": ["a", null] }, "usable": false },
    { "name": "not_in with a nested list", "rule": { "column": "v", "op": "not_in", "value": [[1]] }, "usable": false },
    { "name": "in with an object", "rule": { "column": "v", "op": "in", "value": { "a": 1 } }, "usable": false },

    { "name": "between with no value", "rule": { "column": "v", "op": "between" }, "usable": false },
    { "name": "between with a null value", "rule": { "column": "v", "op": "between", "value": null }, "usable": false },
    { "name": "between with an empty string", "rule": { "column": "v", "op": "between", "value": "" }, "usable": false },
    { "name": "between saved as one text by the old editor", "rule": { "column": "v", "op": "between", "value": "10,100" }, "usable": false },
    { "name": "between with a single number", "rule": { "column": "v", "op": "between", "value": 5 }, "usable": false },
    { "name": "between with one limit", "rule": { "column": "v", "op": "between", "value": [1] }, "usable": false },
    { "name": "between with three limits", "rule": { "column": "v", "op": "between", "value": [1, 2, 3] }, "usable": false },
    { "name": "between with two empty limits", "rule": { "column": "v", "op": "between", "value": ["", ""] }, "usable": false },
    { "name": "between with an empty high limit", "rule": { "column": "v", "op": "between", "value": [10, ""] }, "usable": false },
    { "name": "between with a null low limit", "rule": { "column": "v", "op": "between", "value": [null, 5] }, "usable": false },
    { "name": "between with a blank low limit", "rule": { "column": "v", "op": "between", "value": ["  ", 5] }, "usable": false },
    { "name": "between with an object", "rule": { "column": "v", "op": "between", "value": { "low": 1, "high": 2 } }, "usable": false },
    { "name": "between with nested lists", "rule": { "column": "v", "op": "between", "value": [[1], [2]] }, "usable": false },

    { "name": "regex with no value", "rule": { "column": "v", "op": "regex" }, "usable": false },
    { "name": "regex with a null value", "rule": { "column": "v", "op": "regex", "value": null }, "usable": false },
    { "name": "regex with an empty pattern", "rule": { "column": "v", "op": "regex", "value": "" }, "usable": false },
    { "name": "regex with a number", "rule": { "column": "v", "op": "regex", "value": 100 }, "usable": false },
    { "name": "regex with a list", "rule": { "column": "v", "op": "regex", "value": ["a"] }, "usable": false },

    { "name": "min_length with no value", "rule": { "column": "v", "op": "min_length" }, "usable": false },
    { "name": "min_length with a null value", "rule": { "column": "v", "op": "min_length", "value": null }, "usable": false },
    { "name": "min_length with an empty string", "rule": { "column": "v", "op": "min_length", "value": "" }, "usable": false },
    { "name": "max_length with text", "rule": { "column": "v", "op": "max_length", "value": "abc" }, "usable": false },
    { "name": "min_length with a negative number", "rule": { "column": "v", "op": "min_length", "value": -1 }, "usable": false },
    { "name": "min_length with a negative numeric string", "rule": { "column": "v", "op": "min_length", "value": "-1" }, "usable": false },
    { "name": "min_length with a fraction", "rule": { "column": "v", "op": "min_length", "value": 2.5 }, "usable": false },
    { "name": "max_length with a decimal string", "rule": { "column": "v", "op": "max_length", "value": "2.5" }, "usable": false },
    { "name": "min_length with true", "rule": { "column": "v", "op": "min_length", "value": true }, "usable": false },
    { "name": "min_length with a list", "rule": { "column": "v", "op": "min_length", "value": [3] }, "usable": false }
  ]
}
