# CODEOWNERS — auto-request reviewers for PRs that touch sensitive areas.
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# Added 2026-06-03 during the pre-launch repo-standardisation pass.
# Until a broader maintainer set forms post-launch, the founder is the
# canonical owner of every path — GitHub will auto-tag them on every
# PR. Once contributors land, narrow the rules so per-area experts get
# routed (e.g. backend/auth → security maintainer, frontend/canvas →
# frontend maintainer).
#
# Pattern syntax = .gitignore (closest match wins, last-match wins on
# ties). LEAVE the catch-all at the bottom.

# ── Backend ───────────────────────────────────────────────────────
backend/                          @revoluzen-technologies
backend/revoluzen_flow/auth/              @revoluzen-technologies
backend/revoluzen_flow/security/          @revoluzen-technologies
backend/revoluzen_flow/api/               @revoluzen-technologies

# ── Frontend ──────────────────────────────────────────────────────
frontend/                         @revoluzen-technologies
frontend/src/components/nodes/    @revoluzen-technologies
frontend/src/components/Canvas*   @revoluzen-technologies

# ── Connectors (manifest contributions) ───────────────────────────
backend/revoluzen_flow/connectors/        @revoluzen-technologies

# ── Security-sensitive surfaces — explicitly listed so a future
#    expanded maintainer set still routes these to the security owner.
SECURITY.md                       @revoluzen-technologies
security.md                       @revoluzen-technologies
docs/threat-model.md              @revoluzen-technologies
docs/security/                    @revoluzen-technologies
.github/workflows/security-scan.yml  @revoluzen-technologies
.github/workflows/codeql.yml      @revoluzen-technologies

# ── Release + CI infra ────────────────────────────────────────────
.github/                          @revoluzen-technologies
pyproject.toml                    @revoluzen-technologies
backend/requirements.txt          @revoluzen-technologies
frontend/package.json             @revoluzen-technologies
installer/                        @revoluzen-technologies

# ── Docs (catch-all for unscoped doc PRs — community contributions
#    welcome, owner still gets the auto-request). ──────────────────
docs/                             @revoluzen-technologies
*.md                              @revoluzen-technologies

# ── Catch-all — everything not matched above ──────────────────────
*                                 @revoluzen-technologies
