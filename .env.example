# ─────────────────────────────────────────────────────────────────────────
# Revoluzen Flow environment variables
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and uncomment / edit the lines you need.
# Every setting has a sensible default — Revoluzen Flow runs out of the box with
# an empty `.env`. Settings you DO override show up in the Settings page
# under "Operator Config" so you can see what's wired in.
#
# Reference: docs/deployment.md  (the canonical operator runbook)

# ── Server ───────────────────────────────────────────────────────────────
# Bind port. Default 8001. The docker-compose maps this to 5174 on the host,
# so when running under compose you visit http://localhost:5174 even if
# REVOLUZEN_FLOW_PORT here stays at 8001.
# REVOLUZEN_FLOW_PORT=8001

# Frontend dev-server port (start.bat / start.ps1 path only). Default 5174.
#
# These env vars are PREFERRED ports, not hard requirements. If the
# preferred port is in use by another app, the launcher auto-picks the
# next free port and writes the chosen pair to .revoluzen-flow/runtime/instance.json
# (single source of truth that vite.config.ts and the backend both read).
# So:
#   - Set these only if you have a specific port preference
#   - Leaving them unset is fine - Revoluzen Flow picks free ports either way
#   - The launcher never kills a foreign process on these ports;
#     ownership lives in .revoluzen-flow/runtime/instance.json
# REVOLUZEN_FLOW_FRONTEND_PORT=5174

# Where Revoluzen Flow stores its SQLite DB, logs, eval results, backups, and
# vault key file. Default `./data` (process working dir). With Docker
# Compose this is mounted to a named volume.
# REVOLUZEN_FLOW_DATA_DIR=./data

# Runtime mode: dev | prod. Affects logging verbosity and a few defaults.
# REVOLUZEN_FLOW_MODE=prod

# Deployment role: api | worker. Worker mode requires Revoluzen Flow Enterprise. OSS
# defaults to api and ignores this.
# REVOLUZEN_FLOW_ROLE=api

# Comma-separated CORS origins. Default: same-origin only.
# REVOLUZEN_FLOW_CORS_ORIGINS=https://your-frontend.example.com

# Public URL used in notification deep-links. Default http://localhost:5174.
# REVOLUZEN_FLOW_APP_URL=https://revoluzen-flow.your-domain.com

# ── Image tags (docker-compose only) ─────────────────────────────────────
# Pin or upgrade individual images without bumping Revoluzen Flow itself. See
# changelog.md "Tested with" for the version each release was tested
# against.
# REVOLUZEN_FLOW_IMAGE_TAG=1.0.1
# OLLAMA_IMAGE_TAG=0.5.7

# ── AI providers (all optional) ──────────────────────────────────────────
# Revoluzen Flow works without any LLM — deterministic fallbacks cover every
# AI-assisted feature. Configure one or more of these to unlock the
# Copilot agent, ghost nodes, and error-fix suggestions.
#
# Local LLM (recommended per the privacy-first default).
#
# Native install (Ollama on the host):
# OLLAMA_URL=http://localhost:11434
#
# Docker Compose with `--profile ai`:
# OLLAMA_URL=http://ollama:11434
#
# Setting OLLAMA_URL skips the localhost autoprobe and forces Ollama
# as the AI provider. Leave it unset to fall back to the rule-based
# deterministic planner.

# Cloud providers — set the matching API key. The Insights → AI Provider
# tab lets you pick which one is active and which model to use.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# Pin a specific model. If unset, Revoluzen Flow picks a sensible default per
# provider (claude-sonnet-4 / gpt-4o / qwen2.5:7b for Ollama — the
# 2026-05-19 tool-use floor; sub-7B local models can't drive the agent).
# AI_MODEL=claude-sonnet-4-20250514

# Ollama per-request options (2026-05-22). Sent on every /api/chat call.
# Ollama's own default for num_ctx is 2048, which silently truncates the
# Revoluzen Flow system prompt + tool schemas — keep this at 8192 or above.
# Raise to 16384/32768 only if you have GPU or a high-end CPU.
# REVOLUZEN_FLOW_OLLAMA_NUM_CTX=8192
# REVOLUZEN_FLOW_OLLAMA_TEMPERATURE=0.2
# REVOLUZEN_FLOW_OLLAMA_TOP_P=0.9
# REVOLUZEN_FLOW_OLLAMA_REPEAT_PENALTY=1.05

# Skip the localhost:11434 autoprobe at startup. Useful on machines
# where the probe slows boot.
# REVOLUZEN_FLOW_DISABLE_OLLAMA_AUTOPROBE=1

# Disable retrieval-augmented help (the in-product docs RAG).
# REVOLUZEN_FLOW_DISABLE_RAG=1

# ── Email / SMTP (for alert notifications) ───────────────────────────────
# Notifications can also be configured via the UI. Env vars take effect
# only if the matching UI field is left blank.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=
# SMTP_FROM=revoluzen@example.com
# SMTP_TLS=true

# ── Storage / database ───────────────────────────────────────────────────
# Default: SQLite at $REVOLUZEN_FLOW_DATA_DIR/revoluzen_flow.db. Set this to use Postgres
# instead (Revoluzen Flow Enterprise recommends Postgres for multi-worker setups).
# REVOLUZEN_FLOW_DB_URL=postgresql://user:pass@host:5432/revoluzen_flow

# DuckDB tuning for in-process transforms.
# REVOLUZEN_FLOW_DUCKDB_MEMORY_LIMIT=4GB
# REVOLUZEN_FLOW_DUCKDB_TEMP_DIRECTORY=/tmp/revoluzen-flow-duckdb

# Connection pool size per data-source connection.
# REVOLUZEN_FLOW_CONNECTION_POOL_SIZE=5

# Max upload size in MB (CSV/Excel imports).
# REVOLUZEN_FLOW_UPLOAD_MAX_MB=100

# ── Security ─────────────────────────────────────────────────────────────
# Path to the master encryption key file. Default:
# $REVOLUZEN_FLOW_DATA_DIR/master.key (auto-generated on first boot).
# REVOLUZEN_FLOW_MASTER_KEY_FILE=/secrets/revoluzen-flow-master.key

# HMAC key for signing AI prompts. Auto-generated if unset.
# REVOLUZEN_FLOW_AI_PROMPT_SIGNING_KEY=

# DANGER: disables credential encryption. For ephemeral test environments
# only — never in production.
# REVOLUZEN_FLOW_DISABLE_ENCRYPTION=0

# ── Security knobs (login lockout / SSRF / headers) ─────────────────────
# 2026-05-30: hardening introduced during the launch security audit.
# Defaults are safe for production; tune only if you know why.

# Login rate-limit + account-lockout (api/auth.py). Per-(email, IP)
# sliding window. 3 free attempts → exponential delay (1s → 8s) → hard
# 15-min lockout at 8 failures. Set the soft threshold lower to be
# stricter, or raise the hard threshold if you have legitimate batch
# auth flows (CI tokens, etc.).
# REVOLUZEN_FLOW_LOGIN_SOFT_THRESHOLD=3
# REVOLUZEN_FLOW_LOGIN_HARD_THRESHOLD=8
# REVOLUZEN_FLOW_LOGIN_LOCKOUT_SECONDS=900
# REVOLUZEN_FLOW_LOGIN_WINDOW_SECONDS=900

# AI endpoint per-user rate-limit (ai/rate_limit.py). LLM calls cost
# real money — without this a single leaked session can drain your
# budget. Default 60 calls/hour per user. Streaming endpoints charge
# 2× to reflect longer sessions. Set ENABLE=0 in test environments
# that hammer the endpoint.
# REVOLUZEN_FLOW_AI_RATE_MAX_PER_HOUR=60
# REVOLUZEN_FLOW_AI_RATE_WINDOW_SECONDS=3600
# REVOLUZEN_FLOW_AI_RATE_ENABLE=1

# SSRF guard on the OpenAPI fetcher (connectors/ai_authoring.py).
# By default the fetcher refuses to talk to loopback / link-local /
# private / multicast / reserved IPs (defeats cloud-metadata / internal-
# service exfil). Set to 1 ONLY when running on an internal network
# with a private API catalog you actually want to fetch from.
# REVOLUZEN_FLOW_OPENAPI_FETCH_ALLOW_PRIVATE=0

# Security headers middleware (api/security_headers.py). Defaults are
# sensible; override CSP for a stricter or app-specific policy.
# REVOLUZEN_FLOW_DISABLE_SECURITY_HEADERS=0   # 1 = strip the middleware entirely (NOT recommended)
# REVOLUZEN_FLOW_HSTS_MAX_AGE=31536000        # seconds (default 1 year)
# REVOLUZEN_FLOW_CSP="default-src 'self'; ..."  # full CSP string; empty disables CSP

# ── AI agent tuning (Insights → Copilot) ────────────────────────────────
# Most of these are runtime knobs for the agent loop. The defaults work;
# tune only when you have a specific reason.
# REVOLUZEN_FLOW_AGENT_MAX_ITERATIONS=8       # agent loop budget
# REVOLUZEN_FLOW_AGENT_WALL_CLOCK_S=120       # hard wall-clock cap per agent run
# REVOLUZEN_FLOW_AGENT_DRY_RUN_THRESHOLD=3    # auto-promote dry-runs after N safe tools
# REVOLUZEN_FLOW_NOTIF_LLM_TIMEOUT_S=5        # LLM timeout for notification summarisation
# REVOLUZEN_FLOW_TOOL_SELECTOR=auto           # tool-selection strategy (auto / always_all / disabled)
# REVOLUZEN_FLOW_DISABLE_TOOL_SELECTOR=0      # 1 = always send all tools to the LLM (slower, more accurate)
# REVOLUZEN_FLOW_TOOL_ONLY_MODE=0             # 1 = block LLM free-form output between tool calls

# RAG (in-product docs retrieval) and product knowledge layer.
# REVOLUZEN_FLOW_DISABLE_RAG=0                # 1 = skip the docs RAG entirely
# REVOLUZEN_FLOW_DISABLE_PRODUCT_KNOWLEDGE=0  # 1 = skip the product-fact RAG layer
# REVOLUZEN_FLOW_EMBEDDING_MODEL=             # override the default embedding model name

# Semantic-cache for LLM responses (saves cost on repeat questions).
# REVOLUZEN_FLOW_SEMANTIC_CACHE_TTL_S=3600
# REVOLUZEN_FLOW_SEMANTIC_CACHE_MAX=1000
# REVOLUZEN_FLOW_DISABLE_SEMANTIC_CACHE=0

# Agent prompt signing — non-empty value enables HMAC-signed system
# prompts so injected tool output can't masquerade as instructions.
# Auto-generated on first boot if unset.
# REVOLUZEN_FLOW_AI_PROMPT_SIGNING_KEY=

# Local Ollama base URL — override if Ollama runs on a non-default port
# or on another host inside your network.
# REVOLUZEN_FLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Runtime mode + URLs ─────────────────────────────────────────────────
# REVOLUZEN_FLOW_ENV=dev                      # dev | prod — affects logging verbosity + AI defaults
# REVOLUZEN_FLOW_URL=http://localhost:8001    # base URL the CLI talks to
# REVOLUZEN_FLOW_PUBLIC_URL=                  # canonical public URL for password-reset / share links

# ── Operational toggles ─────────────────────────────────────────────────
# REVOLUZEN_FLOW_ENABLE_API_DOCS=1            # 1 = expose /docs (Swagger UI); 0 = hide in prod
# REVOLUZEN_FLOW_ENABLE_POLICY_ROUTE=0        # 1 = expose /api/policy admin route
# REVOLUZEN_FLOW_WARMUP_HEAVY=0               # 1 = pre-import heavy deps at boot (slower start, faster first request)
# REVOLUZEN_FLOW_DISABLE_STEP_OUTPUT_PRUNE=0  # 1 = keep all step output samples forever (default: dropped 30 days after capture)
# REVOLUZEN_FLOW_TRACE_RETENTION_DAYS=0       # 0 = keep AI agent traces forever; set e.g. 90 to age them out daily
# REVOLUZEN_FLOW_BIN_RETENTION_DAYS=30        # days a deleted pipeline stays in the Bin before a daily job removes it; 0 = never auto-remove
# REVOLUZEN_FLOW_WORKER_PLACEHOLDER_ACK=0     # internal worker-bookkeeping flag — leave 0

# DuckDB-specific knobs (engine tuning).
# REVOLUZEN_FLOW_DUCKDB_TEMP_DIR=             # spill-to-disk directory for big group-bys
# REVOLUZEN_FLOW_DUCKDB_PRESERVE_ORDER=0      # 1 = force ordered execution (slower, deterministic)

# Config-file lookup root (overrides $REVOLUZEN_FLOW_DATA_DIR for config-only files).
# REVOLUZEN_FLOW_CONFIG_HOME=

# OpenRouter integration metadata (only when OPENROUTER_API_KEY set).
# OpenRouter requires HTTP-Referer + X-Title headers for some models;
# set these to your deployment's public face.
# REVOLUZEN_FLOW_OPENROUTER_REFERER=https://your-domain.example/revoluzen-flow
# REVOLUZEN_FLOW_OPENROUTER_TITLE=Revoluzen Flow

# ── Event bus (Plus tier) ───────────────────────────────────────────────
# Default in OSS is in-process (SQLite + in-memory queues). Plus
# deployments swap in NATS for cross-node distribution.
# REVOLUZEN_FLOW_EVENT_BUS=inprocess          # inprocess | nats
# REVOLUZEN_FLOW_NATS_SERVERS=nats://localhost:4222
# REVOLUZEN_FLOW_EVENT_DB=                    # override path for the event-bus SQLite file

# ── Demo / first-run data ────────────────────────────────────────────────
# Seed three example connections (Orders DB / Oracle Fusion / Snowflake DW)
# on a fresh install so the Connections page and Dashboard tiles aren't
# empty from minute zero. Default: off — most operators don't want
# example rows pointing at non-existent endpoints (db.example.com etc.)
# inflating the workspace overview.
#
# Set to 1 / true / yes / on when you want the seed data — useful for:
#   * screenshot harnesses producing marketing material
#   * demo deployments where empty tables look unfinished
#   * tutorial / training environments that walk users through
#     editing an existing connection
#
# The gate only fires when the connections table is literally empty,
# so a populated DB is never re-seeded and an opt-in flag on a
# non-empty workspace is a no-op.
# REVOLUZEN_FLOW_SEED_DEMO_DATA=1

# ── Worker / scheduling ──────────────────────────────────────────────────
# Threshold (minutes) above which a running step is flagged "long-running"
# in notifications.
# REVOLUZEN_FLOW_LONG_RUNNING_THRESHOLD_MIN=30

# Default HTTP node timeout in seconds. The HTTP node's per-step timeout
# overrides this when set.
# REVOLUZEN_FLOW_HTTP_DEFAULT_TIMEOUT=30
